[
  {
    "name": "Derivative with a sign slip",
    "lines": [
      "\\frac{d}{dx}\\left(x^2\\sin x\\right)",
      "=2x\\sin x+x^2\\cos x",
      "=x\\left(2\\sin x+x\\cos x\\right)",
      "=x\\left(2\\sin x-x\\cos x\\right)"
    ]
  },
  {
    "name": "Integration by parts",
    "lines": [
      "\\int x e^{x}\\,dx",
      "=x e^{x}-\\int e^{x}\\,dx",
      "=x e^{x}-e^{x}+C"
    ]
  },
  {
    "name": "Quadratic equation",
    "lines": [
      "x^2-5x+6=0",
      "\\left(x-2\\right)\\left(x-3\\right)=0",
      "x=2\\text{ or }x=3"
    ]
  },
  {
    "name": "Squaring invents a root",
    "lines": [
      "\\sqrt{x}=x-2",
      "x=\\left(x-2\\right)^2",
      "x=1\\text{ or }x=4"
    ]
  },
  {
    "name": "Dividing loses a root",
    "lines": [
      "x^2=x",
      "x=1"
    ]
  },
  {
    "name": "Row reduction",
    "lines": [
      "\\begin{pmatrix}2&1&-1\\\\-3&-1&2\\\\-2&1&2\\end{pmatrix}",
      "\\sim\\begin{pmatrix}1&\\frac{1}{2}&-\\frac{1}{2}\\\\-3&-1&2\\\\-2&1&2\\end{pmatrix}",
      "\\sim\\begin{pmatrix}1&\\frac{1}{2}&-\\frac{1}{2}\\\\0&\\frac{1}{2}&\\frac{1}{2}\\\\0&2&1\\end{pmatrix}"
    ]
  },
  {
    "name": "System, with a slip",
    "lines": [
      "2x+y=5;x-y=1",
      "3x=6;x-y=1",
      "x=2;y=3"
    ]
  }
]
